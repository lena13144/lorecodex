{
  "name": "lorecodex",
  "version": "2.3.1",
  "description": "Vectorless tree-reasoning, millisecond in-RAM grep, and sidecar memory agent for long-form fiction, game lore, SillyTavern / TauriTavern, and DeepSeek Harness / MCP agents.",
  "main": "src/dsh_plugin.js",
  "exports": {
    ".": "./src/dsh_plugin.js",
    "./dsh": "./src/dsh_plugin.js",
    "./mcp": "./src/mcp_server.js",
    "./server": "./src/server.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "lorecodex": "./src/server.js",
    "lorecodex-mcp": "./src/mcp_server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js --tree-only",
    "mcp": "node src/mcp_server.js",
    "test": "node scripts/verify.mjs --offline",
    "build:demo": "node scripts/create_demo_corpus.mjs",
    "build:releases": "node scripts/build_releases.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "rag",
    "vectorless-rag",
    "pageindex",
    "sillytavern",
    "tauritavern",
    "roleplay",
    "lorebook",
    "llm-agent",
    "mcp",
    "dsh-plugin",
    "cordis",
    "deepseek-harness"
  ],
  "author": "lena13144",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lena13144/lorecodex.git"
  },
  "homepage": "https://github.com/lena13144/lorecodex#readme",
  "bugs": {
    "url": "https://github.com/lena13144/lorecodex/issues"
  }
}
